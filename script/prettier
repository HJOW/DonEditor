#!/bin/bash
set -euxo pipefail

PRETTIER_VERSION=3.5.0

pnpm dlx "prettier@${PRETTIER_VERSION}" assets/settings/default.jsonc --check || {
    echo "To fix, run from the root of the Gram repo:"
    echo "  pnpm dlx prettier@${PRETTIER_VERSION} assets/settings/default.jsonc --write"
    false
}

# [DonEditor] 원본 문서를 GramEditor-docs/docs 로 이동함
cd GramEditor-docs/docs
pnpm dlx "prettier@${PRETTIER_VERSION}" . --check || {
    echo "To fix, run from the root of the Gram repo:"
    echo "  cd GramEditor-docs/docs && pnpm dlx prettier@${PRETTIER_VERSION} . --write && cd ../.."
    false
}
